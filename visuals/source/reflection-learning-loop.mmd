flowchart LR
  O["Observed outcome"] --> DOC["Document expected vs actual"] --> L["Learn from success, failure & surprise"] --> H{"Human interpretation"}
  H -->|"local lesson"| P["Update profile or practice"]
  H -->|"bounded experiment"| X["Test reversibly"]
  H -->|"canonical implication"| G["Governance proposal"]
  H -->|"insufficient evidence"| N["No change"]
  P --> V["Validate"] --> R["Repeat or pause"] --> O
  X --> V
  G --> V
