{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://influence-operating-framework.org/schemas/organization.schema.json",
  "title": "Organization record",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/record" },
    {
      "type": "object",
      "required": ["name", "organization_type", "mission_summary", "ecosystem_ids", "person_ids"],
      "properties": {
        "record_type": { "const": "organization" },
        "name": { "$ref": "common.schema.json#/$defs/knownOrUnknownString" },
        "organization_type": { "enum": ["nonprofit", "community", "education", "company", "media", "podcast", "newsletter", "platform", "open_source_project", "user_group", "sponsor", "other"] },
        "mission_summary": { "$ref": "common.schema.json#/$defs/knownOrUnknownString" },
        "ecosystem_ids": { "$ref": "common.schema.json#/$defs/stableIdArray" },
        "person_ids": { "$ref": "common.schema.json#/$defs/stableIdArray" }
      }
    }
  ],
  "unevaluatedProperties": false
}
