{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://influence-operating-framework.org/schemas/common.schema.json",
  "title": "Influence Operating Framework common definitions",
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
    },
    "stableIdArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true,
      "default": []
    },
    "passiveExtensionKey": {
      "allOf": [
        { "pattern": "^[a-z][a-z0-9_.-]*$" },
        { "not": { "pattern": "(^|[._-])(send|sender|sending|credential|credentials|secret|token|password|key|privatekey|apikey|delivery|campaign|retry|webhook)($|[._-])" } }
      ]
    },
    "passiveExtensionValue": {
      "oneOf": [
        { "type": ["string", "number", "integer", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/passiveExtensionValue" } },
        {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/passiveExtensionKey" },
          "additionalProperties": { "$ref": "#/$defs/passiveExtensionValue" }
        }
      ]
    },
    "record": {
      "type": "object",
      "required": [
        "$schema",
        "id",
        "record_type",
        "schema_version",
        "framework_version",
        "created_at",
        "updated_at",
        "status",
        "confidence",
        "privacy",
        "evidence_ids",
        "human_notes",
        "extensions",
        "fictional"
      ],
      "properties": {
        "$schema": { "type": "string", "format": "uri" },
        "id": { "$ref": "#/$defs/stableId" },
        "record_type": { "type": "string" },
        "schema_version": { "const": "3.0.0" },
        "framework_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "status": {
          "enum": ["draft", "active", "verified", "stale", "planned", "completed", "declined", "closed", "archived"]
        },
        "confidence": { "enum": ["unknown", "low", "medium", "high"] },
        "privacy": { "enum": ["public", "community", "private", "sensitive"] },
        "evidence_ids": { "$ref": "#/$defs/stableIdArray" },
        "human_notes": { "type": "string" },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "allOf": [
              { "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" },
              { "$ref": "#/$defs/passiveExtensionKey" }
            ]
          },
          "additionalProperties": { "$ref": "#/$defs/passiveExtensionValue" }
        },
        "fictional": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "allOf": [
              { "not": { "properties": { "record_type": { "const": "evidence" } }, "required": ["record_type"] } },
              {
                "anyOf": [
                  { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
                  { "properties": { "confidence": { "const": "high" } }, "required": ["confidence"] }
                ]
              }
            ]
          },
          "then": { "properties": { "evidence_ids": { "minItems": 1 } } }
        }
      ]
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "knownString": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^[ \\t]*(?:[Tt][Bb][Dd]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Tt][Oo][ \\t]+[Bb][Ee][ \\t]+[Dd][Ee][Tt][Ee][Rr][Mm][Ii][Nn][Ee][Dd]|[Nn][ \\t]*/?[ \\t]*[Aa])[ \\t]*$"
      }
    },
    "unknownValue": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": { "const": "unknown" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "knownOrUnknownString": {
      "oneOf": [
        { "$ref": "#/$defs/knownString" },
        { "$ref": "#/$defs/unknownValue" }
      ]
    },
    "knownOrUnknownDateTime": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "$ref": "#/$defs/unknownValue" }
      ]
    },
    "claimType": { "enum": ["fact", "inference", "hypothesis"] },
    "humanDisposition": { "enum": ["approve", "revise", "wait", "do_not_contact"] },
    "outreachApprovalScope": {
      "type": "object",
      "required": ["outreach_draft_id", "recipient_person_id", "content_sha256", "channel", "expires_at"],
      "properties": {
        "outreach_draft_id": { "$ref": "#/$defs/stableId" },
        "recipient_person_id": { "$ref": "#/$defs/stableId" },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "channel": { "$ref": "#/$defs/nonEmptyString" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "humanDecision": {
      "type": "object",
      "required": ["decision_id", "state", "decided_by_person_id", "decided_at", "reason"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/stableId" },
        "state": { "$ref": "#/$defs/nonEmptyString" },
        "decided_by_person_id": { "$ref": "#/$defs/stableId" },
        "decided_at": { "type": "string", "format": "date-time" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "supersedes_decision_id": { "$ref": "#/$defs/stableId" },
        "review_after": { "type": "string", "format": "date" },
        "approval_scope": { "$ref": "#/$defs/outreachApprovalScope" }
      },
      "additionalProperties": false
    }
  }
}
