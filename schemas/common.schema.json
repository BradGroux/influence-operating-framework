{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://influence-operating-framework.org/schemas/common.schema.json",
  "title": "Influence Operating Framework common definitions",
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
    },
    "stableIdArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true,
      "default": []
    },
    "record": {
      "type": "object",
      "required": [
        "$schema",
        "id",
        "record_type",
        "schema_version",
        "created_at",
        "updated_at",
        "status",
        "confidence",
        "privacy",
        "evidence_ids",
        "human_notes",
        "extensions",
        "fictional"
      ],
      "properties": {
        "$schema": { "type": "string", "format": "uri" },
        "id": { "$ref": "#/$defs/stableId" },
        "record_type": { "type": "string" },
        "schema_version": { "const": "1.0.0" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "status": {
          "enum": ["draft", "active", "verified", "stale", "planned", "completed", "declined", "closed", "archived"]
        },
        "confidence": { "enum": ["unknown", "low", "medium", "high"] },
        "privacy": { "enum": ["public", "community", "private", "sensitive"] },
        "evidence_ids": { "$ref": "#/$defs/stableIdArray" },
        "human_notes": { "type": "string" },
        "extensions": { "type": "object", "additionalProperties": true },
        "fictional": { "type": "boolean" }
      }
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "claimType": { "enum": ["fact", "inference", "hypothesis"] },
    "humanDisposition": { "enum": ["approve", "revise", "wait", "do_not_contact"] },
    "humanDecision": {
      "type": "object",
      "required": ["decision_id", "state", "decided_by_person_id", "decided_at", "reason"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/stableId" },
        "state": { "$ref": "#/$defs/nonEmptyString" },
        "decided_by_person_id": { "$ref": "#/$defs/stableId" },
        "decided_at": { "type": "string", "format": "date-time" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "supersedes_decision_id": { "$ref": "#/$defs/stableId" },
        "review_after": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    }
  }
}
