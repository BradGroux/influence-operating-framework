{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://influence-operating-framework.org/schemas/ecosystem.schema.json",
  "title": "Ecosystem record",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/record" },
    {
      "type": "object",
      "required": ["name", "map_question", "mission_relevance", "boundary", "node_ids", "relationship_ids", "review_after"],
      "properties": {
        "record_type": { "const": "ecosystem" },
        "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "map_question": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "mission_relevance": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "boundary": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "node_ids": { "$ref": "common.schema.json#/$defs/stableIdArray" },
        "relationship_ids": { "$ref": "common.schema.json#/$defs/stableIdArray" },
        "review_after": { "type": "string", "format": "date" }
      }
    }
  ],
  "unevaluatedProperties": false
}
