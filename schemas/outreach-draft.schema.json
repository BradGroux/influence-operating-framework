{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://influence-operating-framework.org/schemas/outreach-draft.schema.json",
  "title": "Human-reviewed outreach draft",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/record" },
    {
      "type": "object",
      "required": ["recipient_person_id", "context", "contribution_id", "draft_content", "channel", "relationship_claims", "disposition", "review_history", "sending_capability"],
      "properties": {
        "record_type": { "const": "outreach_draft" },
        "recipient_person_id": { "$ref": "common.schema.json#/$defs/stableId" },
        "context": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "contribution_id": { "$ref": "common.schema.json#/$defs/stableId" },
        "draft_content": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "channel": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "relationship_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "evidence_ids"],
            "properties": {
              "claim": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
              "evidence_ids": {
                "type": "array",
                "items": { "$ref": "common.schema.json#/$defs/stableId" },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "disposition": { "enum": ["pending_review", "approve", "revise", "wait", "do_not_contact"] },
        "review_history": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/humanDecision" },
              { "properties": { "state": { "enum": ["approve", "revise", "wait", "do_not_contact"] } } },
              {
                "if": { "properties": { "state": { "const": "approve" } }, "required": ["state"] },
                "then": { "required": ["approval_scope"] },
                "else": { "not": { "required": ["approval_scope"] } }
              }
            ]
          }
        },
        "sending_capability": { "const": false }
      }
    },
    {
      "if": { "properties": { "disposition": { "const": "pending_review" } } },
      "then": { "properties": { "review_history": { "maxItems": 0 } } },
      "else": { "properties": { "review_history": { "minItems": 1 } } }
    }
  ],
  "unevaluatedProperties": false
}
