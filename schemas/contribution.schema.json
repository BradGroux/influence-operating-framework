{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://influence-operating-framework.org/schemas/contribution.schema.json",
  "title": "Contribution record",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/record" },
    {
      "type": "object",
      "required": ["title", "need", "beneficiary_ids", "opportunity_ids", "consent_dependencies", "expected_value", "not_expected_in_return", "owner_id", "scope", "due_window", "accessibility_check", "maintenance_or_handoff", "risks", "stop_conditions", "completion_evidence_ids"],
      "properties": {
        "record_type": { "const": "contribution" },
        "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "need": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "beneficiary_ids": { "$ref": "common.schema.json#/$defs/stableIdArray" },
        "opportunity_ids": { "$ref": "common.schema.json#/$defs/stableIdArray" },
        "consent_dependencies": { "type": "array", "items": { "type": "string" } },
        "expected_value": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "not_expected_in_return": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "owner_id": { "$ref": "common.schema.json#/$defs/stableId" },
        "scope": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "due_window": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": { "enum": ["unknown", "planned", "completed", "not_applicable"] },
            "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "starts_on": { "type": "string", "format": "date" },
            "ends_on": { "type": "string", "format": "date" }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "state": { "const": "unknown" } }, "required": ["state"] },
              "then": { "required": ["reason"] }
            }
          ]
        },
        "accessibility_check": {
          "type": "object",
          "required": ["status", "evidence_ids", "notes"],
          "properties": {
            "status": { "enum": ["unknown", "not_required", "pending", "passed", "changes_required"] },
            "evidence_ids": { "$ref": "common.schema.json#/$defs/stableIdArray" },
            "notes": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
              "then": { "properties": { "evidence_ids": { "minItems": 1 } } }
            }
          ]
        },
        "maintenance_or_handoff": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "risks": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "uniqueItems": true },
        "stop_conditions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "minItems": 1, "uniqueItems": true },
        "completion_evidence_ids": { "$ref": "common.schema.json#/$defs/stableIdArray" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "due_window": {
                "properties": { "state": { "enum": ["completed", "not_applicable"] } },
                "required": ["state"]
              },
              "accessibility_check": {
                "properties": { "status": { "enum": ["passed", "not_required"] } },
                "required": ["status"]
              },
              "completion_evidence_ids": { "minItems": 1 }
            }
          }
        }
      ]
    }
  ],
  "unevaluatedProperties": false
}
