{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://influence-operating-framework.org/schemas/relationship.schema.json",
  "title": "Relationship record",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/record" },
    {
      "type": "object",
      "required": ["participant_ids", "relationship_type", "context", "health", "disposition_history", "interaction_ids", "contribution_ids"],
      "properties": {
        "record_type": { "const": "relationship" },
        "participant_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/stableId" }, "minItems": 2, "maxItems": 2, "uniqueItems": true },
        "relationship_type": { "enum": ["community_membership", "professional_familiarity", "collaboration", "mentorship", "introduction", "shared_interest", "other"] },
        "context": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "health": { "enum": ["unknown", "new", "active", "quiet", "needs_repair", "closed"] },
        "disposition_history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/humanDecision" },
              { "properties": { "state": { "enum": ["no_action_needed", "consider", "wait", "do_not_contact"] } } }
            ]
          }
        },
        "interaction_ids": { "$ref": "common.schema.json#/$defs/stableIdArray" },
        "contribution_ids": { "$ref": "common.schema.json#/$defs/stableIdArray" }
      }
    }
  ],
  "unevaluatedProperties": false
}
