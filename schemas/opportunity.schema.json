{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://influence-operating-framework.org/schemas/opportunity.schema.json",
  "title": "Opportunity record",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/record" },
    {
      "type": "object",
      "required": ["title", "opportunity_type", "ecosystem_ids", "beneficiary_ids", "dimensions", "narrative_reasoning", "uncertainty", "decision_history"],
      "properties": {
        "record_type": { "const": "opportunity" },
        "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "opportunity_type": { "enum": ["contribution", "learning", "speaking", "workshop", "media", "community", "collaboration", "commercial", "other"] },
        "ecosystem_ids": { "$ref": "common.schema.json#/$defs/stableIdArray" },
        "beneficiary_ids": { "$ref": "common.schema.json#/$defs/stableIdArray" },
        "dimensions": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "enum": ["low", "medium", "high", "not_applicable"] }
        },
        "narrative_reasoning": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "uncertainty": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "decision_history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/humanDecision" },
              { "properties": { "state": { "enum": ["pursue", "contribute_first", "research", "wait", "decline", "no_action_needed", "do_not_contact"] } } }
            ]
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
